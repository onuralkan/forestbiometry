DirectoryIndex index.php
Options -Indexes

# Last deployed commit (written by the GitHub upload): not public
<Files "deploy-commit.txt">
  Require all denied
</Files>

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set Referrer-Policy strict-origin-when-cross-origin
</IfModule>

# Scripts and styles: the browser asks the server each time whether its copy is still current (ETag), so a
# changed shared module (assets/lab/core/*.js, imported without a version tag) is never served stale.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
